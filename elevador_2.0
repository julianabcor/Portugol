import time

atual = 0
maximo = 2
minimo = 0


while True:
    print('\033[36m===============\033[m')
    print(f'\033[1mO elevador está no andar: {atual}\033[m')
    print('\033[36m===============\033[m')
    destino = int(input("Digite o andar que deseja ir (0 a 10) ou -1 para sair: "))
    print('\033[36m===============\033[m')


    if destino == -1:
        print("Porta abrindo..")
        time.sleep(2)
        print("A porta está aberta.")
        print('\033[36m===============\033[m')
        break

    elif destino < 0 or destino > 10:
        print("Andar inválido! Tente novamente.")
        continue
        

    elif destino == atual:
        print('Você já está nesse andar.')
        continue
       

    print("Porta fechando..")
    time.sleep(2)
    print("Porta fechada.")
    print('\033[36m===============\033[m')
    

    while atual != destino:

        if destino > atual:
            print(f"Subindo... (Passando pelo andar {atual})")
            time.sleep(2)
            atual = atual + 1

        else:
            print(f"Descendo... (Passando pelo andar {atual})")
            time.sleep(2)
            atual = atual - 1


    print('\033[36m===============\033[m')
    print(f'\033[1mChegamos ao andar: {atual}\033[m')
    print('\033[36m===============\033[m')
    print("Porta abrindo..")
    time.sleep(2)
    print("A porta está aberta.")
